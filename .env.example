OPENAI_API_KEY=replace_me
# Required for npm start / hosted deployment. Share separately with reviewers.
DEMO_ACCESS_CODE=choose-a-private-demo-code
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Optional: tried only when direct caption retrieval fails. Server-side secret.
SERPAPI_API_KEY=

# Local npm run dev only. Simulates direct retrieval failure; backup call is real.
DEMO_FORCE_YOUTUBE_FALLBACK=false
